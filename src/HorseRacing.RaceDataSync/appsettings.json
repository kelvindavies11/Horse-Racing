{
  "ConnectionStrings": {
    "HorseRacing": "Host=localhost;Port=5433;Database=horse_racing;Username=horse_racing;Password=horse_racing_local"
  },
  "BhaCollection": {
    "CollectorVersion": "2.0.0",
    "UserAgent": "HorseRacingLocalCollector/2.0 (+https://github.com/kelvindavies11/Horse-Racing)",
    "RequestTimeoutSeconds": 30,
    "RacingStatusApiBearerToken": ""
  },
  "BhaCuratedPromotion": {
    "JobName": "bha-results-to-curated",
    "PromoterVersion": "2.0.0",
    "BatchSize": 1000,
    "RetryFailedPayloads": true,
    "SourceJobNames": []
  },
  "RaceDataSync": {
    "CollectorVersion": "2.0.0",
    "PromotionJobName": "bha-results-to-curated",
    "PromoterVersion": "2.0.0",
    "DelayBetweenRequestsMilliseconds": 10000,
    "WeatherDelayBetweenRequestsMilliseconds": 1000,
    "ThrottleRetryBaseDelayMinutes": 15,
    "MaximumThrottleRetries": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
